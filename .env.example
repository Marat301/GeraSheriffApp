# Optional: Google Cloud Translation API
# EXPO_PUBLIC_GOOGLE_TRANSLATE_API_KEY=

# RevenueCat public SDK keys (from RevenueCat dashboard → Project → API keys)
# Without these keys the app unlocks in local/dev so Expo Go still works.
# Entitlement ID in dashboard: gera_sheriff_premium
# Offering identifier: gerasheriff (must be set as Current)
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_xxx
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_xxx
